{
  "info": {
    "name": "Nutrition API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Food Database",
      "item": [
        {
          "name": "Get All Foods",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/nutrition/foods",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "foods"]
            }
          }
        },
        {
          "name": "Search Foods",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/nutrition/foods/search?query=chicken",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "foods", "search"],
              "query": [
                {
                  "key": "query",
                  "value": "chicken"
                }
              ]
            }
          }
        },
        {
          "name": "Add Food",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/nutrition/foods",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "foods"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Quinoa\",\n  \"calories\": 120,\n  \"protein\": 4.5,\n  \"carbs\": 21.3,\n  \"fat\": 1.9,\n  \"servingSize\": \"100g\"\n}"
            }
          }
        },
        {
          "name": "Update Food",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/nutrition/foods/11",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "foods", "11"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Quinoa\",\n  \"calories\": 125,\n  \"protein\": 4.8,\n  \"carbs\": 22.0,\n  \"fat\": 2.0,\n  \"servingSize\": \"100g\"\n}"
            }
          }
        },
        {
          "name": "Delete Food",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/nutrition/foods/11",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "foods", "11"]
            }
          }
        }
      ]
    },
    {
      "name": "Nutrition Goals",
      "item": [
        {
          "name": "Get Nutrition Goals",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/nutrition/goals",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "goals"]
            }
          }
        },
        {
          "name": "Update Nutrition Goals",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/nutrition/goals",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "goals"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"calorieGoal\": 2200,\n  \"proteinGoal\": 160,\n  \"carbsGoal\": 220,\n  \"fatGoal\": 70\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Nutrition Tracking",
      "item": [
        {
          "name": "Get Weekly Nutrition",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/nutrition/weekly",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "weekly"]
            }
          }
        },
        {
          "name": "Get Daily Nutrition",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/nutrition/daily/0",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "daily", "0"]
            }
          }
        },
        {
          "name": "Add Food to Day",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/nutrition/daily/0/food",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "daily", "0", "food"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 4,\n  \"name\": \"Salmon\",\n  \"calories\": 208,\n  \"protein\": 20,\n  \"carbs\": 0,\n  \"fat\": 13,\n  \"servingSize\": \"100g\"\n}"
            }
          }
        },
        {
          "name": "Update Food in Day",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/nutrition/daily/0/food/4",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "daily", "0", "food", "4"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 4,\n  \"name\": \"Salmon\",\n  \"calories\": 250,\n  \"protein\": 25,\n  \"carbs\": 0,\n  \"fat\": 15,\n  \"servingSize\": \"120g\"\n}"
            }
          }
        },
        {
          "name": "Delete Food from Day",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/nutrition/daily/0/food/4",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "daily", "0", "food", "4"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ]
}
